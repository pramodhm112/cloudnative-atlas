# =============================================================================
# Local development credentials. Copy to `.env` (gitignored) and fill in.
# Production values go into the Vercel project settings (Environment Variables),
# never into a committed file.
# =============================================================================

# Required: admin login password (plaintext compared via timingSafeEqual).
# Replace before production. Future work: migrate to a real KDF (scrypt/argon2).
ADMIN_PASSWORD=admin123

# =============================================================================
# Supabase — content + sessions store. Provision a project at supabase.com,
# then paste:
#   SUPABASE_URL                 = Settings → API → Project URL
#   SUPABASE_ANON_KEY            = Settings → API → Project API keys → anon public
#   SUPABASE_SERVICE_ROLE_KEY    = Settings → API → Project API keys → service_role
# Apply the schema once via Supabase SQL Editor:
#   supabase/migrations/0001_init.sql
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...replace-with-service-role-key

# =============================================================================
# Optional: Vercel Deploy Hook URL. When set, admin actions POST here after
# every successful write so on-demand revalidation regenerates the affected
# static pages. Get the URL at:
#   Vercel project → Settings → Git → Deploy Hooks → Create Hook
# =============================================================================
VERCEL_REVALIDATE_URL=
