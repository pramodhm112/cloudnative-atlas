---
const currentPath = Astro.url.pathname;
const navItems = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
  { name: 'Practice Tests', path: '/practice-tests' },
];
---

<div class="nav-wrapper">
  <nav class="navbar" aria-label="Main navigation">
    <a href="/" class="logo">
      <span class="logo-icon">◈</span>
      <span class="logo-text">CloudNative Atlas</span>
    </a>

    <button class="hamburger" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <ul class="nav-links" id="nav-menu">
      {navItems.map((item) => (
        <li>
          <a
            href={item.path}
            class:list={['nav-link', { active: currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path)) }]}
            aria-current={currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path)) ? 'page' : undefined}
          >
            {item.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('nav-menu');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('open');
    // Animate hamburger to X
    toggle.classList.toggle('is-open');
  });
</script>

<style>
  .nav-wrapper {
    position: sticky;
    top: 0;
    z-index: 1000;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(180deg, rgba(11, 37, 64, 0.95) 0%, rgba(11, 37, 64, 0) 100%);
  }

  .navbar {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: rgba(15, 30, 56, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(0, 229, 255, 0.12);
    border-radius: 14px;
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text-primary);
    transition: all 0.3s ease;
  }

  .logo:hover {
    transform: none;
    text-shadow: none;
  }

  .logo-icon {
    font-size: 1.3rem;
    color: var(--primary);
    filter: drop-shadow(0 0 6px rgba(0, 229, 255, 0.5));
    animation: iconPulse 3s ease-in-out infinite;
  }

  .logo-text {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @keyframes iconPulse {
    0%, 100% { filter: drop-shadow(0 0 6px rgba(0, 229, 255, 0.5)); }
    50% { filter: drop-shadow(0 0 12px rgba(0, 229, 255, 0.8)); }
  }

  /* Nav links */
  .nav-links {
    display: flex;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
    background: rgba(11, 37, 64, 0.5);
    border: 1px solid rgba(0, 229, 255, 0.08);
    border-radius: 10px;
    padding: 0.3rem;
  }

  .nav-link {
    position: relative;
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(0, 229, 255, 0.06);
    text-shadow: none;
  }

  .nav-link.active {
    color: var(--bg-primary);
    background: var(--gradient-1);
    font-weight: 600;
    box-shadow: 0 2px 12px rgba(0, 229, 255, 0.3);
    -webkit-text-fill-color: var(--bg-primary);
  }

  .nav-link.active:hover {
    color: var(--bg-primary);
    text-shadow: none;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    box-shadow: none;
    position: relative;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    transition: background 0.3s ease;
  }

  .hamburger:hover {
    transform: none;
    box-shadow: none;
    background: rgba(0, 229, 255, 0.08);
  }

  .hamburger-line {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: all 0.3s ease;
    transform-origin: center;
  }

  .hamburger.is-open .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger.is-open .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .hamburger.is-open .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .nav-wrapper {
      padding: 0.5rem 0.75rem;
    }

    .navbar {
      flex-wrap: wrap;
      padding: 0.6rem 1rem;
      border-radius: 12px;
    }

    .hamburger {
      display: flex;
    }

    .logo-text {
      font-size: 1.1rem;
    }

    .nav-links {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0.25rem;
      margin-top: 0.75rem;
      padding: 0.4rem;
      background: rgba(11, 37, 64, 0.6);
      border: 1px solid rgba(0, 229, 255, 0.1);
      border-radius: 10px;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-link {
      padding: 0.65rem 1rem;
      font-size: 0.9rem;
      width: 100%;
      text-align: center;
      border-radius: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-icon {
      animation: none;
    }
  }
</style>
