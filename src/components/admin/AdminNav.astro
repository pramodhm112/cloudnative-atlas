---
const currentPath = Astro.url.pathname;
const navItems = [
  { name: 'Dashboard', path: '/admin', icon: 'grid' },
  { name: 'Blog Posts', path: '/admin/posts', icon: 'file-text' },
  { name: 'Projects', path: '/admin/projects', icon: 'code' },
  { name: 'Practice Tests', path: '/admin/tests', icon: 'check-square' },
  { name: 'Courses', path: '/admin/courses', icon: 'book' },
  { name: 'Messages', path: '/admin/messages', icon: 'mail' },
  { name: 'Settings', path: '/admin/settings', icon: 'settings' },
];
---

<!-- Overlay for mobile -->
<div class="sidebar-overlay" id="sidebar-overlay"></div>

<aside class="admin-sidebar" id="admin-sidebar">
  <div class="sidebar-header">
    <a href="/admin" class="admin-logo">
      <span class="logo-icon">&#9670;</span>
      <span class="logo-text">CloudNative Atlas</span>
    </a>
    <!-- Collapse toggle — inline in header, like Atlassian -->
    <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle sidebar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="9" y1="3" x2="9" y2="21"></line>
      </svg>
    </button>
  </div>

  <nav class="sidebar-nav" aria-label="Admin navigation">
    <ul class="sidebar-links">
      {navItems.map((item) => (
        <li>
          <a
            href={item.path}
            class:list={['sidebar-link', { active: currentPath === item.path || (item.path !== '/admin' && currentPath.startsWith(item.path)) }]}
            data-tooltip={item.name}
          >
            {item.icon === 'grid' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            )}
            {item.icon === 'file-text' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            )}
            {item.icon === 'code' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
            )}
            {item.icon === 'check-square' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
            )}
            {item.icon === 'book' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
            )}
            {item.icon === 'mail' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
            )}
            {item.icon === 'settings' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            )}
            <span class="link-label">{item.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="sidebar-footer">
    <a href="/" class="sidebar-link" target="_blank" rel="noopener noreferrer" data-tooltip="View Site">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
      <span class="link-label">View Site</span>
    </a>
    <form method="POST" action="/api/admin/logout" class="logout-form">
      <button type="submit" class="sidebar-link logout-btn" data-tooltip="Logout">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        <span class="link-label">Logout</span>
      </button>
    </form>
  </div>
</aside>

<script>
  const sidebar = document.getElementById('admin-sidebar');
  const sidebarToggle = document.getElementById('sidebar-toggle');
  const overlay = document.getElementById('sidebar-overlay');
  const mobileToggle = document.getElementById('mobile-sidebar-toggle');

  const isMobile = () => window.innerWidth <= 768;

  function applyInitialState() {
    if (isMobile()) {
      document.documentElement.classList.remove('sidebar-collapsed');
      sidebar?.classList.remove('open');
      overlay?.classList.remove('active');
    } else {
      sidebar?.classList.remove('open');
      overlay?.classList.remove('active');
      // Desktop: blocking script in <head> already set the class,
      // but sync in case of resize from mobile → desktop
      const saved = localStorage.getItem('admin-sidebar-collapsed');
      if (saved === 'true') {
        document.documentElement.classList.add('sidebar-collapsed');
      } else {
        document.documentElement.classList.remove('sidebar-collapsed');
      }
    }
  }

  function closeMobileSidebar() {
    sidebar?.classList.remove('open');
    overlay?.classList.remove('active');
  }

  // Sidebar toggle (desktop collapse/expand)
  sidebarToggle?.addEventListener('click', () => {
    if (isMobile()) {
      closeMobileSidebar();
    } else {
      const isCollapsed = document.documentElement.classList.toggle('sidebar-collapsed');
      localStorage.setItem('admin-sidebar-collapsed', String(isCollapsed));
    }
  });

  // Mobile hamburger in header
  mobileToggle?.addEventListener('click', () => {
    const isOpen = sidebar?.classList.toggle('open');
    overlay?.classList.toggle('active', !!isOpen);
  });

  // Overlay click
  overlay?.addEventListener('click', closeMobileSidebar);

  // ESC key to close mobile sidebar
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sidebar?.classList.contains('open')) {
      closeMobileSidebar();
    }
  });

  // Resize
  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(applyInitialState, 150);
  });

  applyInitialState();

  // Remove no-transition class after first paint to enable animations
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      document.documentElement.classList.remove('no-transition');
    });
  });
</script>

<style is:global>
  /* ═══════════════════════════════════════
     OVERLAY
     ═══════════════════════════════════════ */
  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 99;
    backdrop-filter: blur(2px);
  }

  .sidebar-overlay.active {
    display: block;
  }

  /* ═══════════════════════════════════════
     SIDEBAR
     ═══════════════════════════════════════ */
  .admin-sidebar {
    width: 260px;
    min-height: 100vh;
    background: rgba(10, 14, 39, 0.97);
    border-right: 1px solid rgba(0, 229, 255, 0.1);
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    transition: width 0.25s ease, transform 0.25s ease;
    overflow: hidden;
  }

  /* ═══════════════════════════════════════
     SIDEBAR HEADER
     ═══════════════════════════════════════ */
  .sidebar-header {
    padding: 0 1rem;
    border-bottom: 1px solid rgba(0, 229, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    flex-shrink: 0;
  }

  .admin-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    min-width: 0;
  }

  .logo-icon {
    font-size: 1.35rem;
    color: var(--primary);
    flex-shrink: 0;
    line-height: 1;
  }

  .logo-text {
    font-size: 0.9rem;
    font-weight: 700;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity 0.2s ease, width 0.2s ease;
  }

  /* ═══════════════════════════════════════
     SIDEBAR TOGGLE — inline button in header
     ═══════════════════════════════════════ */
  .sidebar-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
    flex-shrink: 0;
    opacity: 0;
  }

  .admin-sidebar:hover .sidebar-toggle,
  .sidebar-toggle:focus-visible {
    opacity: 1;
  }

  .sidebar-toggle:hover {
    background: rgba(0, 229, 255, 0.08);
    color: var(--primary);
  }

  /* Always show toggle when collapsed */
  .sidebar-collapsed .admin-sidebar .sidebar-toggle {
    opacity: 1;
  }

  /* ═══════════════════════════════════════
     NAVIGATION
     ═══════════════════════════════════════ */
  .sidebar-nav {
    flex: 1;
    padding: 0.75rem 0;
    overflow-y: auto;
  }

  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-links li {
    margin: 0;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    margin: 0.125rem 0.5rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.15s ease;
    border: none;
    border-radius: 6px;
    background: none;
    width: calc(100% - 1rem);
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
    overflow: hidden;
    position: relative;
  }

  .sidebar-link svg {
    flex-shrink: 0;
  }

  .link-label {
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity 0.2s ease;
  }

  .sidebar-link:hover {
    color: var(--text-primary);
    background: rgba(0, 229, 255, 0.06);
  }

  .sidebar-link.active {
    color: var(--primary);
    background: rgba(0, 229, 255, 0.1);
  }

  /* ═══════════════════════════════════════
     FOOTER
     ═══════════════════════════════════════ */
  .sidebar-footer {
    padding: 0.5rem 0;
    border-top: 1px solid rgba(0, 229, 255, 0.08);
  }

  .logout-form {
    margin: 0;
  }

  .logout-btn {
    color: var(--text-secondary);
  }

  .logout-btn:hover {
    color: #f44336;
    background: rgba(244, 67, 54, 0.06);
  }

  /* ═══════════════════════════════════════
     MOBILE TOGGLE (in header bar)
     ═══════════════════════════════════════ */
  .mobile-toggle-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
    margin-right: 0.75rem;
  }

  .mobile-toggle-btn:hover {
    background: rgba(0, 229, 255, 0.08);
    color: var(--primary);
  }

  /* ═══════════════════════════════════════
     DESKTOP COLLAPSED (> 768px)
     ═══════════════════════════════════════ */
  @media (min-width: 769px) {
    .mobile-toggle-btn {
      display: none !important;
    }

    .sidebar-collapsed .admin-sidebar {
      width: 64px;
    }

    .sidebar-collapsed .admin-sidebar .logo-text {
      opacity: 0;
      width: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .sidebar-collapsed .admin-sidebar .link-label {
      opacity: 0;
      width: 0;
      pointer-events: none;
    }

    .sidebar-collapsed .admin-sidebar .sidebar-header {
      padding: 0;
      justify-content: center;
    }

    .sidebar-collapsed .admin-sidebar .admin-logo {
      display: none;
    }

    .sidebar-collapsed .admin-sidebar .sidebar-toggle {
      margin: 0;
    }

    .sidebar-collapsed .admin-sidebar .sidebar-link {
      justify-content: center;
      padding: 0.6rem;
      margin: 0.125rem 0.5rem;
      gap: 0;
      width: calc(100% - 1rem);
    }

    /* Tooltip on hover when collapsed */
    .sidebar-collapsed .admin-sidebar .sidebar-link:hover::after {
      content: attr(data-tooltip);
      position: absolute;
      left: 100%;
      top: 50%;
      transform: translateY(-50%);
      margin-left: 12px;
      padding: 0.4rem 0.75rem;
      background: rgba(10, 14, 39, 0.95);
      border: 1px solid rgba(0, 229, 255, 0.15);
      border-radius: 6px;
      color: var(--text-primary);
      font-size: 0.8rem;
      white-space: nowrap;
      z-index: 110;
      pointer-events: none;
    }
  }

  /* ═══════════════════════════════════════
     MOBILE / TABLET (≤ 768px)
     ═══════════════════════════════════════ */
  @media (max-width: 768px) {
    .sidebar-toggle {
      display: none !important;
    }

    .mobile-toggle-btn {
      display: flex;
    }

    .admin-sidebar {
      transform: translateX(-100%);
      width: 280px;
      box-shadow: none;
    }

    .admin-sidebar.open {
      transform: translateX(0);
      box-shadow: 4px 0 30px rgba(0, 0, 0, 0.4);
    }
  }
</style>
