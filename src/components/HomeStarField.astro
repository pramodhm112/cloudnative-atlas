---
// Bonus starfield layered on top of the default 8-star Layout backdrop.
// Used only on the home page to give the landing view extra atmosphere.
// Positions, sizes, colors, and timings deliberately differ from the base
// set so the combined effect looks natural, not cloned.
---

<div class="home-stars" aria-hidden="true">
  <div class="hstar hstar-1"></div>
  <div class="hstar hstar-2"></div>
  <div class="hstar hstar-3"></div>
  <div class="hstar hstar-4"></div>
  <div class="hstar hstar-5"></div>
  <div class="hstar hstar-6"></div>
  <div class="hstar hstar-7"></div>
  <div class="hstar hstar-8"></div>
  <div class="hstar hstar-9"></div>
  <div class="hstar hstar-10"></div>
  <div class="hstar hstar-11"></div>
  <div class="hstar hstar-12"></div>
</div>

<style>
  /* Same fixed-viewport backdrop pattern as StarField, stacked below content
     but above the base StarField gradient glow. */
  .home-stars {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
  }

  .hstar {
    position: absolute;
    border-radius: 50%;
    animation:
      htwinkle var(--d, 4s) ease-in-out infinite,
      hdrift var(--s, 9s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }

  /* Cyan cluster — top band */
  .hstar-1 { width: 2px; height: 2px; top: 6%;  left: 22%;
    background: var(--primary); box-shadow: 0 0 4px var(--primary);
    --d: 3.2s; --s: 8s;  --delay: 0.4s; }
  .hstar-2 { width: 3px; height: 3px; top: 9%;  left: 58%;
    background: var(--primary); box-shadow: 0 0 6px var(--primary);
    --d: 4.1s; --s: 11s; --delay: 1.8s; }
  .hstar-3 { width: 2px; height: 2px; top: 14%; left: 40%;
    background: var(--primary); box-shadow: 0 0 4px var(--primary);
    --d: 3.7s; --s: 9.5s; --delay: 2.5s; }

  /* Orange cluster — middle band, more movement */
  .hstar-4 { width: 3px; height: 3px; top: 34%; left: 12%;
    background: var(--secondary); box-shadow: 0 0 6px var(--secondary);
    --d: 4.3s; --s: 10s; --delay: 0.2s; }
  .hstar-5 { width: 2px; height: 2px; top: 38%; left: 64%;
    background: var(--secondary); box-shadow: 0 0 4px var(--secondary);
    --d: 3.4s; --s: 9s; --delay: 1.1s; }
  .hstar-6 { width: 2px; height: 2px; top: 45%; left: 30%;
    background: var(--secondary); box-shadow: 0 0 4px var(--secondary);
    --d: 3.9s; --s: 12s; --delay: 2.2s; }

  /* Blue accent — lower band, drifts longer */
  .hstar-7 { width: 2px; height: 2px; top: 58%; left: 50%;
    background: var(--accent); box-shadow: 0 0 4px var(--accent);
    --d: 3.6s; --s: 10.5s; --delay: 0.9s; }
  .hstar-8 { width: 3px; height: 3px; top: 62%; left: 78%;
    background: var(--accent); box-shadow: 0 0 6px var(--accent);
    --d: 4.4s; --s: 11.5s; --delay: 1.6s; }
  .hstar-9 { width: 2px; height: 2px; top: 68%; left: 20%;
    background: var(--accent); box-shadow: 0 0 4px var(--accent);
    --d: 3.3s; --s: 8.5s; --delay: 2.7s; }

  /* Bottom band — mixed palette + one larger "hero" star */
  .hstar-10 { width: 4px; height: 4px; top: 88%; left: 68%;
    background: var(--primary);
    box-shadow: 0 0 8px var(--primary), 0 0 16px rgba(var(--primary-rgb), 0.3);
    --d: 5.2s; --s: 13s; --delay: 1.3s; }
  .hstar-11 { width: 2px; height: 2px; top: 92%; left: 44%;
    background: var(--secondary); box-shadow: 0 0 4px var(--secondary);
    --d: 3.5s; --s: 9s; --delay: 0.6s; }
  .hstar-12 { width: 3px; height: 3px; top: 96%; left: 10%;
    background: var(--primary); box-shadow: 0 0 6px var(--primary);
    --d: 4s;   --s: 10.5s; --delay: 2.1s; }

  @keyframes htwinkle {
    0%, 100% { opacity: 0.25; }
    50%      { opacity: 0.9; }
  }

  /* Slightly wider drift than the base StarField's 'dangle' to give the
     home page a livelier, more animated feel. */
  @keyframes hdrift {
    0%, 100% { transform: translate(0, 0); }
    25%      { transform: translate(6px, -12px); }
    50%      { transform: translate(-5px, -20px); }
    75%      { transform: translate(3px, -10px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hstar { animation: none; opacity: 0.35; }
  }
</style>
