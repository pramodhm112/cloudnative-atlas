---
// Search component for practice tests
---

<div class="search-container">
  <div class="search-box">
    <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
    <input
      type="text"
      id="test-search-input"
      placeholder="Search practice tests..."
      class="search-input"
    />
  </div>
  <div id="test-search-results" class="search-results"></div>
</div>

<script>
  interface Test {
    slug: string;
    title: string;
    description: string;
    category: string;
    difficulty: string;
    tags?: string[];
    timeLimit?: number;
    passingScore: number;
  }

  let allTests: Test[] = [];
  let searchTimeout: ReturnType<typeof setTimeout>;

  async function loadTests() {
    try {
      const response = await fetch('/api/tests.json');
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      allTests = await response.json();
    } catch (error) {
      console.error('Error loading tests:', error);
      const container = document.getElementById('test-search-results');
      if (container) {
        const msg = document.createElement('p');
        msg.className = 'no-results';
        msg.textContent = 'Failed to load search data';
        container.replaceChildren(msg);
      }
    }
  }

  function searchTests(query: string) {
    const container = document.getElementById('test-search-results');
    if (!container) return;

    if (!query.trim()) {
      container.replaceChildren();
      return;
    }

    const lowerQuery = query.toLowerCase();
    const results = allTests.filter(test => {
      const titleMatch = test.title.toLowerCase().includes(lowerQuery);
      const descMatch = test.description.toLowerCase().includes(lowerQuery);
      const tagMatch = test.tags?.some((tag: string) => tag.toLowerCase().includes(lowerQuery));
      const categoryMatch = test.category.toLowerCase().includes(lowerQuery);
      const difficultyMatch = test.difficulty.toLowerCase().includes(lowerQuery);

      return titleMatch || descMatch || tagMatch || categoryMatch || difficultyMatch;
    }).slice(0, 10);

    displayResults(results, container);
  }

  function displayResults(results: Test[], container: HTMLElement) {
    if (results.length === 0) {
      const msg = document.createElement('p');
      msg.className = 'no-results';
      msg.textContent = 'No tests found';
      container.replaceChildren(msg);
      return;
    }

    const fragment = document.createDocumentFragment();
    results.forEach(test => {
      const link = document.createElement('a');
      link.href = `/practice-tests/${test.slug}`;
      link.className = 'search-result-item';

      const badge = document.createElement('span');
      badge.className = `result-badge ${test.category.toLowerCase()}`;
      badge.textContent = test.category;

      const title = document.createElement('span');
      title.className = 'result-title';
      title.textContent = test.title;

      const diff = document.createElement('span');
      diff.className = `result-difficulty ${test.difficulty.toLowerCase()}`;
      diff.textContent = test.difficulty;

      link.appendChild(badge);
      link.appendChild(title);
      link.appendChild(diff);
      fragment.appendChild(link);
    });
    container.replaceChildren(fragment);
  }

  // Initialize search on page load
  document.addEventListener('DOMContentLoaded', () => {
    loadTests();

    const searchInput = document.getElementById('test-search-input') as HTMLInputElement;
    searchInput?.addEventListener('input', (e) => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        searchTests((e.target as HTMLInputElement).value);
      }, 300);
    });

    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const container = document.getElementById('test-search-results');
        if (container) container.replaceChildren();
        searchInput.blur();
      }
    });

    // Close search results when clicking outside
    document.addEventListener('click', (e) => {
      const container = document.querySelector('.search-container');
      if (!container?.contains(e.target as Node)) {
        const results = document.getElementById('test-search-results');
        if (results) results.replaceChildren();
      }
    });
  });
</script>

<style>
  .search-container {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
  }

  .search-box {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-secondary);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 1rem 1rem 1rem 3rem;
    background: var(--bg-secondary);
    border: 2px solid var(--border);
    border-radius: 12px;
    color: var(--text-primary);
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: var(--shadow-glow);
  }

  .search-input::placeholder {
    color: var(--text-secondary);
  }

  .search-results {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    max-height: 400px;
    overflow-y: auto;
    z-index: 100;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  }

  .search-results :global(.search-result-item) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid rgba(0, 229, 255, 0.08);
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .search-results :global(.search-result-item:last-child) {
    border-bottom: none;
  }

  .search-results :global(.search-result-item:hover) {
    background: var(--bg-tertiary);
  }

  .search-results :global(.result-badge) {
    flex-shrink: 0;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.03em;
  }

  .search-results :global(.result-badge.devops) {
    background: rgba(255, 149, 0, 0.15);
    color: var(--secondary);
  }

  .search-results :global(.result-badge.cloud) {
    background: rgba(0, 229, 255, 0.15);
    color: var(--primary);
  }

  .search-results :global(.result-badge.ai) {
    background: rgba(77, 159, 255, 0.15);
    color: var(--accent);
  }

  .search-results :global(.result-badge.security) {
    background: rgba(255, 184, 0, 0.15);
    color: var(--security);
  }

  .search-results :global(.result-title) {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--text-primary);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }

  .search-results :global(.search-result-item:hover .result-title) {
    color: var(--primary);
  }

  .search-results :global(.result-difficulty) {
    flex-shrink: 0;
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    letter-spacing: 0.03em;
  }

  .search-results :global(.result-difficulty.beginner) {
    background: rgba(76, 175, 80, 0.15);
    color: #4caf50;
  }

  .search-results :global(.result-difficulty.intermediate) {
    background: rgba(255, 152, 0, 0.15);
    color: #ff9800;
  }

  .search-results :global(.result-difficulty.advanced) {
    background: rgba(244, 67, 54, 0.15);
    color: #f44336;
  }

  .search-results :global(.no-results) {
    padding: 1.5rem;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .search-results {
      max-height: 300px;
    }
  }
</style>
