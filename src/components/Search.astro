---
// Unified search component for all listing pages.
// Variant controls what extra info appears on each result row:
//   - 'simple'     → badge + title (blog)
//   - 'difficulty' → badge + title + difficulty pill (projects, tests)
//   - 'meta'       → badge + title + meta line (courses: "3 modules · 7 topics · Beginner")
import '../styles/search.css';

interface Props {
  placeholder: string;
  endpoint: string;
  urlPrefix: string;
  variant?: 'simple' | 'difficulty' | 'meta';
  notFoundText?: string;
  errorText?: string;
}

const {
  placeholder,
  endpoint,
  urlPrefix,
  variant = 'simple',
  notFoundText = 'No results found',
  errorText = 'Failed to load search data',
} = Astro.props;
---

<div
  class="search-container"
  data-endpoint={endpoint}
  data-url-prefix={urlPrefix}
  data-variant={variant}
  data-not-found={notFoundText}
  data-error-text={errorText}
>
  <div class="search-box">
    <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
    <input
      type="text"
      placeholder={placeholder}
      class="search-input"
      autocomplete="off"
    />
  </div>
  <div class="search-results"></div>
</div>

<script>
  interface SearchItem {
    slug: string;
    title: string;
    description: string;
    category: string;
    difficulty?: string;
    tags?: string[];
    technologies?: string[];
    moduleCount?: number;
    topicCount?: number;
  }

  function initSearch(container: HTMLElement) {
    const endpoint = container.dataset.endpoint!;
    const urlPrefix = container.dataset.urlPrefix!;
    const variant = (container.dataset.variant || 'simple') as 'simple' | 'difficulty' | 'meta';
    const notFoundText = container.dataset.notFound || 'No results found';
    const errorText = container.dataset.errorText || 'Failed to load search data';

    const input = container.querySelector<HTMLInputElement>('.search-input');
    const results = container.querySelector<HTMLDivElement>('.search-results');
    if (!input || !results) return;

    let items: SearchItem[] = [];
    let timeout: ReturnType<typeof setTimeout>;
    let loaded = false;

    async function load() {
      if (loaded) return;
      try {
        const res = await fetch(endpoint);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        items = await res.json();
        loaded = true;
      } catch {
        const msg = document.createElement('p');
        msg.className = 'no-results';
        msg.textContent = errorText;
        results!.replaceChildren(msg);
      }
    }

    function matches(item: SearchItem, q: string): boolean {
      if (item.title.toLowerCase().includes(q)) return true;
      if (item.description.toLowerCase().includes(q)) return true;
      if (item.category.toLowerCase().includes(q)) return true;
      if (item.difficulty?.toLowerCase().includes(q)) return true;
      if (item.tags?.some((t) => t.toLowerCase().includes(q))) return true;
      if (item.technologies?.some((t) => t.toLowerCase().includes(q))) return true;
      return false;
    }

    function render(filtered: SearchItem[]) {
      if (filtered.length === 0) {
        const msg = document.createElement('p');
        msg.className = 'no-results';
        msg.textContent = notFoundText;
        results!.replaceChildren(msg);
        return;
      }

      const frag = document.createDocumentFragment();
      filtered.slice(0, 10).forEach((item) => {
        const link = document.createElement('a');
        link.href = `${urlPrefix}/${item.slug}`;
        link.className = 'search-result-item';

        const badge = document.createElement('span');
        badge.className = `result-badge ${item.category.toLowerCase()}`;
        badge.textContent = item.category;
        link.appendChild(badge);

        const title = document.createElement('span');
        title.className = 'result-title';
        title.textContent = item.title;
        link.appendChild(title);

        if (variant === 'difficulty' && item.difficulty) {
          const diff = document.createElement('span');
          diff.className = `result-difficulty ${item.difficulty.toLowerCase()}`;
          diff.textContent = item.difficulty;
          link.appendChild(diff);
        } else if (variant === 'meta') {
          const meta = document.createElement('span');
          meta.className = 'result-meta';
          const parts: string[] = [];
          if (item.moduleCount != null) parts.push(`${item.moduleCount} modules`);
          if (item.topicCount != null) parts.push(`${item.topicCount} topics`);
          if (item.difficulty) parts.push(item.difficulty);
          meta.textContent = parts.join(' · ');
          link.appendChild(meta);
        }

        frag.appendChild(link);
      });
      results!.replaceChildren(frag);
    }

    input.addEventListener('input', () => {
      clearTimeout(timeout);
      const q = input.value.trim().toLowerCase();
      if (!q) {
        results.replaceChildren();
        return;
      }
      timeout = setTimeout(async () => {
        await load();
        render(items.filter((it) => matches(it, q)));
      }, 300);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        results.replaceChildren();
        input.blur();
      }
    });

    document.addEventListener('click', (e) => {
      if (!container.contains(e.target as Node)) {
        results.replaceChildren();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('.search-container').forEach(initSearch);
  });
</script>
