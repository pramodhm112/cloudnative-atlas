---
// Twinkling star field background effect
---

<div class="star-field" aria-hidden="true">
  <div class="star star-1"></div>
  <div class="star star-2"></div>
  <div class="star star-3"></div>
  <div class="star star-4"></div>
  <div class="star star-5"></div>
  <div class="star star-6"></div>
  <div class="star star-7"></div>
  <div class="star star-8"></div>
  <div class="star star-9"></div>
  <div class="star star-10"></div>
  <div class="star star-11"></div>
  <div class="star star-12"></div>
</div>

<style>
  .star-field {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .star {
    position: absolute;
    border-radius: 50%;
    animation: twinkle var(--duration, 4s) ease-in-out infinite, dangle var(--sway, 6s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }

  /* Small cyan stars */
  .star-1 {
    width: 3px; height: 3px;
    top: 12%; left: 8%;
    background: var(--primary);
    box-shadow: 0 0 6px var(--primary), 0 0 12px rgba(0, 229, 255, 0.3);
    --duration: 3s; --sway: 7s; --delay: 0s;
  }

  .star-2 {
    width: 2px; height: 2px;
    top: 25%; left: 85%;
    background: var(--primary);
    box-shadow: 0 0 4px var(--primary);
    --duration: 4.5s; --sway: 8s; --delay: 1.2s;
  }

  .star-3 {
    width: 4px; height: 4px;
    top: 65%; left: 15%;
    background: var(--primary);
    box-shadow: 0 0 8px var(--primary), 0 0 16px rgba(0, 229, 255, 0.2);
    --duration: 5s; --sway: 9s; --delay: 0.5s;
  }

  /* Orange accent stars */
  .star-4 {
    width: 3px; height: 3px;
    top: 18%; left: 72%;
    background: var(--secondary);
    box-shadow: 0 0 6px var(--secondary), 0 0 12px rgba(255, 149, 0, 0.3);
    --duration: 3.5s; --sway: 6.5s; --delay: 2s;
  }

  .star-5 {
    width: 2px; height: 2px;
    top: 78%; left: 88%;
    background: var(--secondary);
    box-shadow: 0 0 4px var(--secondary);
    --duration: 4s; --sway: 7.5s; --delay: 0.8s;
  }

  /* Blue accent stars */
  .star-6 {
    width: 3px; height: 3px;
    top: 42%; left: 92%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent), 0 0 12px rgba(77, 159, 255, 0.3);
    --duration: 4.2s; --sway: 8.5s; --delay: 1.5s;
  }

  .star-7 {
    width: 2px; height: 2px;
    top: 55%; left: 5%;
    background: var(--accent);
    box-shadow: 0 0 4px var(--accent);
    --duration: 3.8s; --sway: 7s; --delay: 2.5s;
  }

  /* More scattered small stars */
  .star-8 {
    width: 2px; height: 2px;
    top: 8%; left: 45%;
    background: var(--primary);
    box-shadow: 0 0 4px var(--primary);
    --duration: 5.5s; --sway: 9.5s; --delay: 0.3s;
  }

  .star-9 {
    width: 3px; height: 3px;
    top: 72%; left: 55%;
    background: var(--primary);
    box-shadow: 0 0 6px var(--primary);
    --duration: 3.2s; --sway: 6s; --delay: 1.8s;
  }

  .star-10 {
    width: 2px; height: 2px;
    top: 35%; left: 30%;
    background: var(--secondary);
    box-shadow: 0 0 4px var(--secondary);
    --duration: 4.8s; --sway: 8s; --delay: 3s;
  }

  .star-11 {
    width: 2px; height: 2px;
    top: 48%; left: 65%;
    background: var(--accent);
    box-shadow: 0 0 4px var(--accent);
    --duration: 3.6s; --sway: 7.2s; --delay: 0.6s;
  }

  .star-12 {
    width: 4px; height: 4px;
    top: 85%; left: 35%;
    background: var(--primary);
    box-shadow: 0 0 8px var(--primary), 0 0 16px rgba(0, 229, 255, 0.2);
    --duration: 5.2s; --sway: 10s; --delay: 2.2s;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.8; }
  }

  @keyframes dangle {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(3px, -8px); }
    50% { transform: translate(-4px, -15px); }
    75% { transform: translate(2px, -6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .star {
      animation: none;
      opacity: 0.3;
    }
  }
</style>
