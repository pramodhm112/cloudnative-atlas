---
import Layout from '../../layouts/Layout.astro';
import '../../styles/listing-page.css';
import '../../styles/prose.css';
import { getCollection, render } from 'astro:content';
import { formatTag } from '../../utils/formatTag';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => p.data.status !== 'draft')
    .map((project) => ({
      // Content Layer API: entry.id is the slug-shaped path (no extension)
      params: { slug: project.id },
      props: project,
    }));
}

const project = Astro.props;
const { Content } = await render(project);

const formattedDate = new Date(project.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = project.data.pubDate.toISOString();
const siteUrl = Astro.site || 'https://cloudnativeatlas.com';

const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": project.data.title,
  "description": project.data.description,
  "datePublished": isoDate,
  "dateModified": isoDate,
  "author": { "@type": "Person", "name": project.data.author },
  "publisher": {
    "@type": "Organization",
    "name": "CloudNative Atlas",
    "logo": { "@type": "ImageObject", "url": new URL('/logo.png', siteUrl).toString() }
  },
  "mainEntityOfPage": new URL(`/projects/${project.id}`, siteUrl).toString(),
  "articleSection": project.data.category,
  "keywords": project.data.tags?.join(', ') || '',
  "proficiencyLevel": project.data.difficulty,
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl.toString() },
    { "@type": "ListItem", "position": 2, "name": "Projects", "item": new URL('/projects', siteUrl).toString() },
    { "@type": "ListItem", "position": 3, "name": project.data.title }
  ]
});
---

<Layout
  title={`${project.data.title} | CloudNative Atlas`}
  description={project.data.description}
  ogType="article"
  articleMeta={{
    publishedTime: isoDate,
    modifiedTime: isoDate,
    author: project.data.author,
    section: project.data.category,
    tags: project.data.tags,
  }}
>
  <script type="application/ld+json" set:html={articleSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <article class="project-detail">
    <div class="container">
      <header class="project-header">
        <div class="project-meta">
          <span class={`category-badge ${project.data.category.toLowerCase()}`}>
            {project.data.category}
          </span>
          <span class={`difficulty-badge ${project.data.difficulty.toLowerCase()}`}>
            {project.data.difficulty}
          </span>
          <time class="project-date" datetime={isoDate}>{formattedDate}</time>
        </div>

        <h1 class="project-title gradient-heading">{project.data.title}</h1>
        <p class="project-description">{project.data.description}</p>

        {project.data.technologies && project.data.technologies.length > 0 && (
          <div class="tech-chips">
            {project.data.technologies.map((tech) => (
              <span class="tech-chip">{tech}</span>
            ))}
          </div>
        )}

        <div class="project-info">
          <span class="project-author">By {project.data.author}</span>
          {project.data.tags && project.data.tags.length > 0 && (
            <div class="project-tags">
              {project.data.tags.map((tag) => (
                <span class="tag">{formatTag(tag)}</span>
              ))}
            </div>
          )}
        </div>

        {project.data.sourceUrl && (
          <div class="source-link-wrapper">
            <a href={project.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="source-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              View Source Code
            </a>
          </div>
        )}
      </header>

      <div class="post-content prose glass">
        <Content />
      </div>

      <footer class="project-footer">
        <div class="back-link">
          <a href="/projects" class="back-button">Back to Projects</a>
        </div>
      </footer>
    </div>
  </article>
</Layout>

<style>
  .project-detail {
    padding: 4rem 0;
  }

  .project-header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--border);
  }

  .project-meta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .category-badge {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
  }

  .project-date {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .project-title {
    font-size: 3.5rem;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  .project-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 800px;
    margin: 0 auto 2rem;
  }

  .tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .tech-chip {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
    background: rgba(0, 229, 255, 0.08);
    color: var(--primary);
    border: 1px solid rgba(0, 229, 255, 0.15);
  }

  .project-info {
    display: flex;
    gap: 2rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .project-author {
    font-size: 1rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .source-link-wrapper {
    margin-top: 0.5rem;
  }

  .source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: transparent;
    border: 2px solid var(--border);
    border-radius: 10px;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .source-link:hover {
    border-color: var(--primary);
    color: var(--primary);
    box-shadow: var(--shadow-glow);
    transform: translateY(-2px);
  }

  .post-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .project-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 2px solid var(--border);
  }

  .back-link {
    text-align: center;
  }

  @media (max-width: 768px) {
    .project-title {
      font-size: 2rem;
    }

    .project-description {
      font-size: 1rem;
    }

    .post-content {
      padding: 1.5rem;
      font-size: 1rem;
    }
  }
</style>
