---
import Layout from '../layouts/Layout.astro';
import HomeStarField from '../components/HomeStarField.astro';
import '../styles/listing-page.css';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 6);

const categories = [
  { name: 'DevOps', icon: '⚙️', color: 'devops', desc: 'CI/CD, Containers, IaC, and Platform Engineering.' },
  { name: 'Cloud', icon: '☁️', color: 'cloud', desc: 'AWS, Azure, GCP, and Cloud Architecture Patterns.' },
  { name: 'AI', icon: '🤖', color: 'ai', desc: 'LLMs, ML Systems, Agents, and Practical AI Engineering.' },
  { name: 'Security', icon: '🔐', color: 'security', desc: 'AppSec, Zero Trust, IAM, and Compliance.' },
];

// Count content per category for the tiles.
const categoryStats = Object.fromEntries(
  categories.map((c) => [
    c.name,
    {
      articles: posts.filter((p) => p.data.category === c.name).length,
    },
  ])
);
---

<Layout title="CloudNative Atlas - DevOps, Cloud, AI & Security">
  <HomeStarField />
  <div class="home-page">
  <div class="hero">
    <div class="container">
      <div class="hero-content fade-in">
        <h1 class="hero-title gradient-heading">
          Welcome to <span class="gradient-text">CloudNative Atlas</span>
        </h1>
        <p class="hero-subtitle">
          Your comprehensive guide to navigating the CloudNative ecosystem with cutting-edge insights on DevOps, Cloud, AI, and Security
        </p>
        <div class="hero-buttons">
          <a href="/blog" class="button primary">Explore Articles</a>
          <a href="/practice-tests" class="button secondary">Take Practice Tests</a>
        </div>
      </div>
    </div>
  </div>

  <section class="categories">
    <div class="container">
      <h2 class="section-title gradient-heading">Explore by Category</h2>
      <div class="category-grid">
        {categories.map((category) => (
          <a href={`/blog?category=${category.name}`} class={`category-card ${category.color}`}>
            <span class="category-icon" aria-hidden="true">{category.icon}</span>
            <h3>{category.name}</h3>
            <p class="category-desc">{category.desc}</p>
            <span class="category-count">{categoryStats[category.name].articles} articles</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="latest-posts">
    <div class="container">
      <h2 class="section-title gradient-heading">Latest Articles</h2>
      <div class="listing-grid">
        {posts.map((post) => (
          <article class="post-card listing-card glass">
            <div class="card-badges">
              <span class={`category-badge ${post.data.category.toLowerCase()}`}>
                {post.data.category}
              </span>
              <time class="card-date" datetime={post.data.pubDate.toISOString()}>
                {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric'
                })}
              </time>
            </div>
            <h3 class="card-title">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h3>
            <p class="card-desc">{post.data.description}</p>
            <div class="card-footer">
              <span class="card-author" title={post.data.author}>{post.data.author}</span>
              <a href={`/blog/${post.id}`} class="card-action">
                Read More
              </a>
            </div>
          </article>
        ))}
      </div>
      <div class="view-all">
        <a href="/blog" class="button">View All Articles</a>
      </div>
    </div>
  </section>
  </div>
</Layout>

<style>
  /* Home page is a navigation launcher — every visible element is either a
     click target or a decorative heading. Disabling text selection here
     prevents the ugly drag-highlight when users brush across cards trying
     to click them. Content pages (blog, course topics) keep selection
     enabled, with the brand-styled ::selection rule in global.css. */
  .home-page,
  .home-page * {
    user-select: none;
    -webkit-user-select: none;
  }

  .hero {
    padding: 6rem 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1000px;
    height: 1000px;
    background: radial-gradient(circle, rgba(0, 245, 255, 0.1) 0%, transparent 70%);
    transform: translate(-50%, -50%);
    animation: pulse 8s ease-in-out infinite;
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-title {
    font-size: 4rem;
    margin-bottom: 1.5rem;
    line-height: 1.1;
    overflow-wrap: break-word;
  }

  .gradient-text {
    background: var(--gradient-1);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 700px;
    margin: 0 auto 2.5rem;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Hero buttons inherit the site-wide pill shape + contained shadow from
     global.css (.button / .back-button rule). Only override the bits
     specific to the hero layout (larger padding for prominence, secondary
     variant as transparent outline). */
  .button {
    padding: 1rem 2.25rem;
    font-size: 1.05rem;
  }

  .button.secondary {
    background: transparent;
    background-clip: padding-box;
    border: 2px solid var(--primary);
    color: var(--primary);
    box-shadow: none;
  }

  .button.secondary:hover,
  .button.secondary:focus-visible {
    background: rgba(0, 229, 255, 0.1);
    color: var(--primary);
    box-shadow: 0 0 14px rgba(0, 229, 255, 0.25);
  }

  .categories,
  .latest-posts {
    padding: 4rem 0;
  }

  .section-title {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 3rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .category-card {
    background: var(--bg-secondary);
    border: 2px solid var(--border);
    border-radius: 16px;
    padding: 3rem 2rem;
    text-align: center;
    text-decoration: none;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .category-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--gradient-1);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .category-card:hover::before {
    opacity: 0.1;
  }

  .category-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-glow);
    border-color: var(--primary);
  }

  .category-card.devops:hover {
    border-color: var(--secondary);
  }

  .category-card.cloud:hover {
    border-color: var(--primary);
  }

  .category-card.ai:hover {
    border-color: var(--accent);
  }

  .category-card.security:hover {
    border-color: var(--security);
  }

  .category-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 0.75rem;
    filter: drop-shadow(0 0 10px var(--glow));
  }

  .category-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin: 0.4rem 0 0.75rem;
    line-height: 1.5;
  }

  .category-count {
    font-size: 0.72rem;
    color: var(--text-secondary);
    opacity: 0.7;
    margin-top: auto;
  }

  .category-card h3 {
    font-size: 1.5rem;
    color: var(--text-primary);
  }

  /* Card internal styles now shared in listing-page.css */

  .view-all {
    text-align: center;
    margin-top: 3rem;
  }

  @media (max-width: 1024px) {
    .hero-title {
      font-size: 2.25rem;
    }

    .hero-subtitle {
      font-size: 1.05rem;
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 1.75rem;
    }

    .hero-subtitle {
      font-size: 0.95rem;
    }

    .category-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .category-card {
      padding: 2rem 1rem;
    }

    .category-icon {
      font-size: 3rem;
    }

    .category-card h3 {
      font-size: 1.1rem;
      word-break: break-word;
    }
  }

  @media (max-width: 380px) {
    .category-card {
      padding: 1.5rem 0.75rem;
    }

    .category-card h3 {
      font-size: 1rem;
    }

    .category-icon {
      font-size: 2.5rem;
    }
  }
</style>
