---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listContactMessages } from '../../../lib/contact-store';
import { COUNTRIES } from '../../../data/countries';

export const prerender = false;

const messages = listContactMessages();
const unreadCount = messages.filter((m) => !m.read).length;

// Build an ISO-code → country-name map for nicer table cells.
const countryNames = new Map(COUNTRIES.map((c) => [c.code, c.name]));

// Quick stats for the status row.
const now = Date.now();
const dayMs = 24 * 60 * 60 * 1000;
const last24h = messages.filter((m) => now - new Date(m.receivedAt).getTime() < dayMs).length;
const last7d = messages.filter((m) => now - new Date(m.receivedAt).getTime() < 7 * dayMs).length;

const deleted = Astro.url.searchParams.get('deleted');
---

<AdminLayout title="Contact Messages">
  {deleted && <div class="admin-alert admin-alert-success">Message deleted.</div>}

  <div class="page-actions">
    <span class="post-count">
      {messages.length} {messages.length === 1 ? 'Message' : 'Messages'}
      {unreadCount > 0 && <span class="unread-pill">{unreadCount} unread</span>}
    </span>
    <div class="quick-stats">
      <span class="stat-chip"><strong>{last24h}</strong> in 24h</span>
      <span class="stat-chip"><strong>{last7d}</strong> in 7d</span>
    </div>
  </div>

  <div class="search-bar">
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      type="text"
      id="search-input"
      class="admin-input"
      placeholder="Search by name, email, country, or message…"
      autocomplete="off"
    />
  </div>

  {messages.length > 0 ? (
    <div class="admin-card">
      <table class="admin-table">
        <thead>
          <tr>
            <th class="serial-cell">#</th>
            <th>Received</th>
            <th>From</th>
            <th>Email</th>
            <th>Mobile</th>
            <th>Country</th>
            <th>Message</th>
            <th class="actions-col">Actions</th>
          </tr>
        </thead>
        <tbody>
          {messages.map((m, index) => (
            <tr class:list={['msg-row', { unread: !m.read }]} data-id={m.id}>
              <td class="serial-cell">{index + 1}</td>
              <td class="recv-cell" title={m.receivedAt}>
                {!m.read && <span class="dot" aria-label="unread"></span>}
                <span class="recv-date">
                  {new Date(m.receivedAt).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </span>
                <span class="recv-time">
                  {new Date(m.receivedAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })}
                </span>
              </td>
              <td>
                <a href={`/admin/messages/${m.id}`} class="post-title-link">
                  {m.firstName} {m.lastName}
                </a>
              </td>
              <td class="email-cell">
                <a href={`mailto:${m.email}`} class="email-link">{m.email}</a>
              </td>
              <td class="mobile-cell">
                <a href={`tel:${m.dialCode}${m.mobile}`} class="mobile-link">
                  {m.dialCode} {m.mobile}
                </a>
              </td>
              <td>
                <span class="country-cell">
                  <span class="country-code">{m.country}</span>
                  <span class="country-name">{countryNames.get(m.country) ?? m.country}</span>
                </span>
              </td>
              <td class="message-cell" title={m.message}>
                {m.message.length > 80 ? m.message.slice(0, 80) + '…' : m.message}
              </td>
              <td>
                <div class="admin-actions">
                  <a href={`/admin/messages/${m.id}`} class="admin-btn admin-btn-secondary admin-btn-sm">View</a>
                  <button
                    class="admin-btn admin-btn-outline admin-btn-sm read-btn"
                    data-id={m.id}
                    data-read={m.read ? 'true' : 'false'}
                    title={m.read ? 'Mark as unread' : 'Mark as read'}
                  >
                    {m.read ? 'Unread' : 'Read'}
                  </button>
                  <button
                    class="admin-btn admin-btn-danger admin-btn-sm delete-btn"
                    data-id={m.id}
                    data-from={`${m.firstName} ${m.lastName}`}
                  >
                    Delete
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <div class="admin-card admin-empty">
      <p>No contact messages yet.</p>
      <p style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.5rem;">
        Submissions from <a href="/contact" target="_blank">/contact</a> will appear here.
      </p>
    </div>
  )}
</AdminLayout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const tableRows = document.querySelectorAll<HTMLElement>('.admin-table tbody tr');
  const countLabel = document.querySelector('.post-count');

  const baseCount = tableRows.length;

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    let visible = 0;
    tableRows.forEach((row) => {
      const text = (row.textContent ?? '').toLowerCase();
      const match = !q || text.includes(q);
      row.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (countLabel && visible !== baseCount) {
      // Show filtered count without losing the unread pill — use a temp text node.
      const pill = countLabel.querySelector('.unread-pill')?.outerHTML ?? '';
      const word = visible === 1 ? 'Message' : 'Messages';
      countLabel.innerHTML = `${visible} ${word}${pill ? ' ' + pill : ''}`;
    }
  });

  // Mark as read / unread (toggles)
  document.querySelectorAll('.read-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLElement;
      const id = target.dataset.id;
      const current = target.dataset.read === 'true';
      const next = !current;
      target.disabled = true;

      try {
        const res = await fetch(`/api/admin/messages/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ read: next }),
        });
        if (!res.ok) {
          const data = await res.json();
          alert(`Failed to update: ${data.error || 'Unknown error'}`);
          target.disabled = false;
          return;
        }
        // Reflect new state in the row without a full reload
        target.dataset.read = String(next);
        target.textContent = next ? 'Unread' : 'Read';
        target.title = next ? 'Mark as unread' : 'Mark as read';
        const row = target.closest<HTMLElement>('.msg-row');
        row?.classList.toggle('unread', !next);
        // Remove or add the unread dot
        const dot = row?.querySelector('.dot');
        if (next && dot) dot.remove();
        if (!next && row && !dot) {
          const dotEl = document.createElement('span');
          dotEl.className = 'dot';
          dotEl.setAttribute('aria-label', 'unread');
          row.querySelector('.recv-cell')?.prepend(dotEl);
        }
      } catch {
        alert('Network error.');
      } finally {
        target.disabled = false;
      }
    });
  });

  // Delete
  document.querySelectorAll('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLElement;
      const id = target.dataset.id;
      const from = target.dataset.from;
      if (!confirm(`Delete the message from "${from}"? This cannot be undone.`)) return;

      try {
        const res = await fetch(`/api/admin/messages/${id}`, { method: 'DELETE' });
        if (res.ok) {
          window.location.href = '/admin/messages?deleted=1';
        } else {
          const data = await res.json();
          alert(`Failed to delete: ${data.error || 'Unknown error'}`);
        }
      } catch {
        alert('Network error.');
      }
    });
  });
</script>

<style>
  .page-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .post-count {
    color: var(--text-secondary);
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .unread-pill {
    background: var(--secondary);
    color: var(--bg-primary);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .quick-stats {
    display: flex;
    gap: 0.5rem;
  }

  .stat-chip {
    padding: 0.35rem 0.75rem;
    background: rgba(0, 229, 255, 0.06);
    border: 1px solid rgba(0, 229, 255, 0.15);
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .stat-chip strong {
    color: var(--primary);
    font-weight: 700;
    margin-right: 0.25rem;
  }

  .post-title-link {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .post-title-link:hover {
    color: var(--primary);
  }

  .search-bar {
    position: relative;
    margin-bottom: 1.25rem;
  }

  .search-bar .search-icon {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-secondary);
    opacity: 0.6;
    pointer-events: none;
  }

  .search-bar .admin-input {
    padding-left: 2.5rem;
  }

  .serial-cell {
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.85rem;
    width: 40px;
  }

  .actions-col {
    width: 200px;
  }

  .recv-cell {
    white-space: nowrap;
    color: var(--text-secondary);
    font-size: 0.82rem;
    position: relative;
  }
  .recv-date {
    display: inline-block;
    color: var(--text-primary);
    font-size: 0.85rem;
    margin-right: 0.4rem;
  }
  .recv-time {
    color: var(--text-secondary);
    font-size: 0.78rem;
  }

  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--secondary);
    border-radius: 50%;
    margin-right: 0.4rem;
    box-shadow: 0 0 8px rgba(255, 149, 0, 0.6);
    vertical-align: middle;
  }

  .msg-row.unread .post-title-link {
    font-weight: 700;
  }

  .email-link,
  .mobile-link {
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.85rem;
  }

  .email-link:hover,
  .mobile-link:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  .country-cell {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .country-code {
    background: rgba(0, 229, 255, 0.1);
    color: var(--primary);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .country-name {
    color: var(--text-secondary);
    font-size: 0.85rem;
    white-space: nowrap;
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .message-cell {
    color: var(--text-secondary);
    font-size: 0.85rem;
    max-width: 280px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .admin-btn-outline {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .admin-btn-outline:hover {
    color: var(--primary);
    border-color: rgba(0, 229, 255, 0.3);
    background: rgba(0, 229, 255, 0.05);
  }

  @media (max-width: 1024px) {
    .message-cell {
      max-width: 180px;
    }
    .country-name {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .page-actions {
      flex-direction: column;
      align-items: flex-start;
    }
    .actions-col,
    .admin-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
