---
import AdminLayout from '../../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="New Blog Post">
  <div class="form-container">
    <form id="post-form" class="admin-card">
      <div class="form-grid">
        <div class="admin-form-group form-full">
          <label for="title">Title *</label>
          <input type="text" id="title" name="title" class="admin-input" required placeholder="Enter post title" />
        </div>

        <div class="admin-form-group form-full">
          <label for="description">Description *</label>
          <input type="text" id="description" name="description" class="admin-input" required placeholder="Brief description of the post" />
        </div>

        <div class="admin-form-group">
          <label for="category">Category *</label>
          <select id="category" name="category" class="admin-select" required>
            <option value="">Select category</option>
            <option value="DevOps">DevOps</option>
            <option value="Cloud">Cloud</option>
            <option value="AI">AI</option>
            <option value="Security">Security</option>
          </select>
        </div>

        <div class="admin-form-group">
          <label for="author">Author</label>
          <input type="text" id="author" name="author" class="admin-input" value="CloudNative Atlas Team" />
        </div>

        <div class="admin-form-group">
          <label for="tags">Tags (comma-separated)</label>
          <input type="text" id="tags" name="tags" class="admin-input" placeholder="kubernetes, devops, cloud" />
        </div>

        <div class="admin-form-group">
          <label for="image">Image URL (optional)</label>
          <input type="text" id="image" name="image" class="admin-input" placeholder="/images/post-image.jpg" />
        </div>

        <div class="admin-form-group form-full">
          <label for="body">Content (MDX) *</label>
          <textarea id="body" name="body" class="admin-textarea" required placeholder="Write your post content in MDX format...

# Heading

Your content here with **bold**, *italic*, and `code` formatting.

## Subheading

```yaml
apiVersion: v1
kind: Pod
```"></textarea>
        </div>
      </div>

      <div id="form-error" class="admin-alert admin-alert-error" style="display: none;"></div>

      <div class="form-actions">
        <a href="/admin/posts" class="admin-btn admin-btn-secondary">Cancel</a>
        <button type="button" class="admin-btn admin-btn-outline" id="save-draft-btn">Save as Draft</button>
        <button type="submit" class="admin-btn admin-btn-primary" id="submit-btn">Save &amp; Publish</button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  import { actions } from 'astro:actions';

  const form = document.getElementById('post-form') as HTMLFormElement;
  const errorEl = document.getElementById('form-error') as HTMLElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const draftBtn = document.getElementById('save-draft-btn') as HTMLButtonElement;

  async function savePost(status: 'draft' | 'published') {
    errorEl.style.display = 'none';
    submitBtn.disabled = true;
    draftBtn.disabled = true;

    const title = (document.getElementById('title') as HTMLInputElement).value.trim();
    const description = (document.getElementById('description') as HTMLInputElement).value.trim();
    const category = (document.getElementById('category') as HTMLSelectElement).value as
      | 'DevOps' | 'Cloud' | 'AI' | 'Security';
    const author = (document.getElementById('author') as HTMLInputElement).value.trim();
    const tagsRaw = (document.getElementById('tags') as HTMLInputElement).value.trim();
    const image = (document.getElementById('image') as HTMLInputElement).value.trim();
    const body = (document.getElementById('body') as HTMLTextAreaElement).value;
    const tags = tagsRaw ? tagsRaw.split(',').map((t) => t.trim()).filter(Boolean) : [];

    const label = status === 'draft' ? 'Saving...' : 'Publishing...';
    (status === 'draft' ? draftBtn : submitBtn).textContent = label;

    const { error } = await actions.posts.create({
      title, description, category, author, tags, image, body, status,
    });

    if (error) {
      errorEl.textContent = error.message || 'Failed to create post';
      errorEl.style.display = 'block';
      submitBtn.disabled = false;
      draftBtn.disabled = false;
      submitBtn.textContent = 'Save & Publish';
      draftBtn.textContent = 'Save as Draft';
    } else {
      window.location.href = '/admin/posts?success=1';
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    savePost('published');
  });

  draftBtn.addEventListener('click', () => savePost('draft'));
</script>

<style>
  .form-container {
    max-width: 900px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 1.5rem;
  }

  .form-full {
    grid-column: 1 / -1;
  }

  .form-actions {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(0, 229, 255, 0.08);
  }

  .admin-btn-outline {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid rgba(255,255,255,0.1);
  }
  .admin-btn-outline:hover {
    color: var(--primary);
    border-color: rgba(0,229,255,0.3);
    background: rgba(0,229,255,0.05);
  }

  @media (max-width: 768px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
