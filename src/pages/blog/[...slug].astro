---
import Layout from '../../layouts/Layout.astro';
import FocusToggle from '../../components/FocusToggle.astro';
import '../../styles/listing-page.css';
import '../../styles/prose.css';
import { getCollection, render } from 'astro:content';
import { formatTag } from '../../utils/formatTag';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter((post) => post.data.status !== 'draft').map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = post.data.pubDate.toISOString();
const siteUrl = Astro.site || 'https://cloudnativeatlas.com';

const blogPostSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": isoDate,
  "dateModified": isoDate,
  "author": {
    "@type": "Person",
    "name": post.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "CloudNative Atlas",
    "logo": { "@type": "ImageObject", "url": new URL('/logo.png', siteUrl).toString() }
  },
  "mainEntityOfPage": new URL(`/blog/${post.id}`, siteUrl).toString(),
  "image": post.data.image ? new URL(post.data.image, siteUrl).toString() : new URL('/logo.png', siteUrl).toString(),
  "articleSection": post.data.category,
  "keywords": post.data.tags?.join(', ') || ''
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl.toString() },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": new URL('/blog', siteUrl).toString() },
    { "@type": "ListItem", "position": 3, "name": post.data.title }
  ]
});
---

<Layout
  title={`${post.data.title} | CloudNative Atlas`}
  description={post.data.description}
  ogType="article"
  articleMeta={{
    publishedTime: isoDate,
    modifiedTime: isoDate,
    author: post.data.author,
    section: post.data.category,
    tags: post.data.tags,
  }}
>
  <script type="application/ld+json" set:html={blogPostSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <article class="blog-post">
    <div class="container">
      <div class="post-toolbar">
        <FocusToggle label="Toggle focus mode for this article" />
      </div>

      <header class="post-header">
        <div class="post-meta">
          <span class={`category-badge ${post.data.category.toLowerCase()}`}>
            {post.data.category}
          </span>
          <time class="post-date" datetime={isoDate}>{formattedDate}</time>
        </div>

        <h1 class="post-title gradient-heading">{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>

        <div class="post-info">
          <span class="post-author">By {post.data.author}</span>
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.map((tag) => (
                <span class="tag">{formatTag(tag)}</span>
              ))}
            </div>
          )}
        </div>
      </header>

      <div class="post-content prose glass">
        <Content />
      </div>

      <footer class="post-footer">
        <div class="back-link">
          <a href="/blog" class="back-button">Back to Blog</a>
        </div>
      </footer>
    </div>
  </article>
</Layout>

<style>
  .blog-post {
    padding: 4rem 0;
  }

  .post-toolbar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1.5rem;
  }

  .post-header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--border);
  }

  .post-meta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .category-badge {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
  }

  .post-date {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .post-title {
    font-size: 3.5rem;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  .post-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 800px;
    margin: 0 auto 2rem;
  }

  .post-info {
    display: flex;
    gap: 2rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .post-author {
    font-size: 1rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tag {
    font-size: 0.9rem;
    color: var(--primary);
    opacity: 0.8;
  }

  .post-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 2px solid var(--border);
  }

  .back-link {
    text-align: center;
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: 2rem;
    }

    .post-description {
      font-size: 1rem;
    }

    .post-content {
      padding: 1.5rem;
      font-size: 1rem;
    }
  }
</style>
