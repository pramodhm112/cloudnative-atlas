---
import Layout from '../../layouts/Layout.astro';
import Search from '../../components/Search.astro';
import ListingHeader from '../../components/ListingHeader.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import '../../styles/listing-page.css';
import { getCollection } from 'astro:content';
import { formatTag } from '../../utils/formatTag';
import { isPublished } from '../../lib/publish-status';
import { computeCategoryCounts } from '../../utils/categoryCounts';

const allPosts = (await getCollection('blog'))
  .filter((post) => isPublished(post.data))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const categories = ['All', 'DevOps', 'Cloud', 'AI', 'Security'];
const categoryCounts = computeCategoryCounts(allPosts, (p) => p.data.category);
---

<Layout title="Blog - CloudNative Atlas" description="Explore articles on DevOps, Cloud, AI, and Security">
  <ListingHeader title="Tech Blog" subtitle="Insights, tutorials, and best practices for modern technology">
    <Search
      placeholder="Search articles..."
      endpoint="/api/posts.json"
      urlPrefix="/blog"
      variant="simple"
      notFoundText="No results found"
    />
    <CategoryFilter categories={categories} itemLabel="posts" counts={categoryCounts} total={allPosts.length} />
  </ListingHeader>

  <section class="listing-content">
    <div class="container">
      <div class="listing-grid">
        {allPosts.map((post) => (
          <article class="post-card listing-card glass" data-category={post.data.category}>
            <div class="card-badges">
              <span class={`category-badge ${post.data.category.toLowerCase()}`}>
                {post.data.category}
              </span>
              <time class="card-date" datetime={post.data.pubDate.toISOString()}>
                {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
            </div>
            <h2 class="card-title">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h2>
            <p class="card-desc">{post.data.description}</p>
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="card-tags">
                {post.data.tags.map((tag) => (
                  <span class="tag">{formatTag(tag)}</span>
                ))}
              </div>
            )}
            <div class="card-footer">
              <span class="card-author" title={post.data.author}>{post.data.author}</span>
              <a href={`/blog/${post.id}`} class="card-action">
                Read More
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initCategoryFilter } from '../../scripts/category-filter';
  initCategoryFilter('.post-card');
</script>
