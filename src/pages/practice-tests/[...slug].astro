---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const tests = await getCollection('tests');
  return tests.map((test) => ({
    params: { slug: test.slug },
    props: test,
  }));
}

const test = Astro.props;
const { Content } = await test.render();
---

<Layout title={test.data.title} description={test.data.description}>
  <div class="test-page">
    <div class="container">
      <header class="test-header">
        <div class="test-meta">
          <span class={`category-badge ${test.data.category.toLowerCase()}`}>
            {test.data.category}
          </span>
          <span class={`difficulty-badge ${test.data.difficulty.toLowerCase()}`}>
            {test.data.difficulty}
          </span>
        </div>

        <h1 class="test-title">{test.data.title}</h1>
        <p class="test-description">{test.data.description}</p>

        <div class="test-info">
          {test.data.timeLimit && (
            <div class="info-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>Time Limit: {test.data.timeLimit} minutes</span>
            </div>
          )}
          <div class="info-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <span>Passing Score: {test.data.passingScore}%</span>
          </div>
        </div>
      </header>

      <div class="test-controls glass">
        <div class="timer" id="timer">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span id="time-remaining">--:--</span>
        </div>
        <div class="progress">
          <span id="question-progress">Question 0 of 0</span>
        </div>
        <button id="submit-test" class="submit-btn">Submit Test</button>
      </div>

      <div class="test-content glass" id="test-content">
        <Content />
      </div>

      <div class="results-section glass" id="results" style="display: none;">
        <h2>Test Results</h2>
        <div class="score-display">
          <div class="score-circle">
            <span id="score-percentage">0%</span>
          </div>
          <div class="score-details">
            <p id="score-text"></p>
            <p id="correct-count"></p>
          </div>
        </div>
        <div class="results-actions">
          <button id="review-answers" class="button">Review Answers</button>
          <button id="retake-test" class="button secondary">Retake Test</button>
          <a href="/practice-tests" class="button secondary">Back to Tests</a>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ timeLimit: test.data.timeLimit, passingScore: test.data.passingScore }}>
    let questions = [];
    let currentQuestion = 0;
    let userAnswers = {};
    let timerInterval;
    let timeRemaining = timeLimit ? timeLimit * 60 : 0;

    function parseQuestions() {
      const content = document.getElementById('test-content');
      const questionBlocks = content.querySelectorAll('blockquote');

      questionBlocks.forEach((block, index) => {
        const questionText = block.querySelector('p:first-child')?.textContent || '';
        const options = [];
        const optionElements = block.querySelectorAll('ul li, ol li');

        optionElements.forEach((opt) => {
          const text = opt.textContent.trim();
          const isCorrect = text.startsWith('*') || text.startsWith('[x]');
          options.push({
            text: text.replace(/^\*\s*/, '').replace(/^\[x\]\s*/, '').replace(/^\[\s\]\s*/, ''),
            isCorrect: isCorrect,
          });
        });

        questions.push({
          question: questionText,
          options: options,
        });
      });

      renderQuiz();
      if (timeLimit) {
        startTimer();
      }
    }

    function renderQuiz() {
      const content = document.getElementById('test-content');
      content.replaceChildren();

      questions.forEach((q, index) => {
        const questionDiv = document.createElement('div');
        questionDiv.className = 'question-block';
        questionDiv.id = `question-${index}`;
        questionDiv.style.display = index === 0 ? 'block' : 'none';

        const heading = document.createElement('h3');
        heading.textContent = `Question ${index + 1}`;
        questionDiv.appendChild(heading);

        const questionText = document.createElement('p');
        questionText.className = 'question-text';
        questionText.textContent = q.question;
        questionDiv.appendChild(questionText);

        const optionsDiv = document.createElement('div');
        optionsDiv.className = 'options';

        q.options.forEach((option, optIndex) => {
          const label = document.createElement('label');
          label.className = 'option';

          const input = document.createElement('input');
          input.type = 'radio';
          input.name = `question-${index}`;
          input.value = String(optIndex);

          const span = document.createElement('span');
          span.textContent = option.text;

          label.appendChild(input);
          label.appendChild(span);
          optionsDiv.appendChild(label);

          input.addEventListener('change', () => {
            userAnswers[index] = optIndex;
            updateProgress();
          });
        });

        questionDiv.appendChild(optionsDiv);

        const navDiv = document.createElement('div');
        navDiv.className = 'question-nav';

        if (index > 0) {
          const prevBtn = document.createElement('button');
          prevBtn.className = 'nav-btn';
          prevBtn.textContent = '\u2190 Previous';
          prevBtn.addEventListener('click', () => navigateQuestion(index - 1));
          navDiv.appendChild(prevBtn);
        }
        if (index < questions.length - 1) {
          const nextBtn = document.createElement('button');
          nextBtn.className = 'nav-btn';
          nextBtn.textContent = 'Next \u2192';
          nextBtn.addEventListener('click', () => navigateQuestion(index + 1));
          navDiv.appendChild(nextBtn);
        }

        questionDiv.appendChild(navDiv);
        content.appendChild(questionDiv);
      });

      updateProgress();
    }

    function navigateQuestion(index) {
      document.getElementById(`question-${currentQuestion}`).style.display = 'none';
      document.getElementById(`question-${index}`).style.display = 'block';
      currentQuestion = index;
    }

    function updateProgress() {
      const answered = Object.keys(userAnswers).length;
      document.getElementById('question-progress').textContent = `${answered} of ${questions.length} answered`;
    }

    function startTimer() {
      const timerDisplay = document.getElementById('time-remaining');
      const timerContainer = document.getElementById('timer');

      const updateDisplay = () => {
        const minutes = Math.floor(timeRemaining / 60);
        const seconds = timeRemaining % 60;
        timerDisplay.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

        if (timeRemaining <= 300) {
          timerContainer.classList.add('timer-warning');
        }
      };

      updateDisplay();

      timerInterval = setInterval(() => {
        timeRemaining--;
        updateDisplay();

        if (timeRemaining <= 0) {
          clearInterval(timerInterval);
          submitTest();
        }
      }, 1000);
    }

    function submitTest() {
      if (timerInterval) {
        clearInterval(timerInterval);
      }

      let correctCount = 0;
      questions.forEach((q, index) => {
        const userAnswer = userAnswers[index];
        if (userAnswer !== undefined) {
          if (q.options[userAnswer].isCorrect) {
            correctCount++;
          }
        }
      });

      const percentage = Math.round((correctCount / questions.length) * 100);
      const passed = percentage >= passingScore;

      document.getElementById('test-content').style.display = 'none';
      document.querySelector('.test-controls').style.display = 'none';

      const resultsSection = document.getElementById('results');
      resultsSection.style.display = 'block';

      document.getElementById('score-percentage').textContent = `${percentage}%`;
      document.getElementById('score-text').textContent = passed
        ? 'Congratulations! You passed!'
        : 'Keep learning! You can retake the test.';
      document.getElementById('correct-count').textContent = `${correctCount} out of ${questions.length} correct`;

      const scoreCircle = document.querySelector('.score-circle');
      scoreCircle.style.background = passed
        ? 'linear-gradient(135deg, #4caf50 0%, #45a049 100%)'
        : 'linear-gradient(135deg, #f44336 0%, #e53935 100%)';
    }

    function reviewAnswers() {
      document.getElementById('results').style.display = 'none';
      document.getElementById('test-content').style.display = 'block';
      document.querySelector('.test-controls').style.display = 'flex';

      questions.forEach((q, index) => {
        const questionDiv = document.getElementById(`question-${index}`);
        const userAnswer = userAnswers[index];

        const options = questionDiv.querySelectorAll('.option');
        options.forEach((opt, optIndex) => {
          if (q.options[optIndex].isCorrect) {
            opt.classList.add('correct');
          } else if (optIndex === userAnswer) {
            opt.classList.add('incorrect');
          }
          opt.querySelector('input').disabled = true;
        });
      });

      document.getElementById('submit-test').style.display = 'none';
    }

    function retakeTest() {
      window.location.reload();
    }

    document.addEventListener('DOMContentLoaded', () => {
      parseQuestions();

      document.getElementById('submit-test').addEventListener('click', () => {
        if (confirm('Are you sure you want to submit the test?')) {
          submitTest();
        }
      });

      const reviewBtn = document.getElementById('review-answers');
      if (reviewBtn) {
        reviewBtn.addEventListener('click', reviewAnswers);
      }

      const retakeBtn = document.getElementById('retake-test');
      if (retakeBtn) {
        retakeBtn.addEventListener('click', retakeTest);
      }
    });

    // Clean up timer on page navigation
    window.addEventListener('beforeunload', () => {
      if (timerInterval) clearInterval(timerInterval);
    });
  </script>
</Layout>

<style>
  .test-page {
    padding: 3rem 0;
  }

  .test-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--border);
  }

  .test-meta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .category-badge,
  .difficulty-badge {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .category-badge.devops {
    background: rgba(255, 149, 0, 0.2);
    color: var(--secondary);
  }

  .category-badge.cloud {
    background: rgba(0, 229, 255, 0.2);
    color: var(--primary);
  }

  .category-badge.ai {
    background: rgba(77, 159, 255, 0.2);
    color: var(--accent);
  }

  .category-badge.security {
    background: rgba(255, 184, 0, 0.2);
    color: var(--security);
  }

  .difficulty-badge.beginner {
    background: rgba(76, 175, 80, 0.2);
    color: #4caf50;
  }

  .difficulty-badge.intermediate {
    background: rgba(255, 152, 0, 0.2);
    color: #ff9800;
  }

  .difficulty-badge.advanced {
    background: rgba(244, 67, 54, 0.2);
    color: #f44336;
  }

  .test-title {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .test-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 700px;
    margin: 0 auto 1.5rem;
  }

  .test-info {
    display: flex;
    gap: 2rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
  }

  .info-item svg {
    color: var(--primary);
  }

  .test-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .timer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--primary);
    transition: color 0.3s ease;
  }

  .timer :global(.timer-warning) {
    color: #f44336;
  }

  :global(.timer-warning) {
    color: #f44336 !important;
  }

  .progress {
    color: var(--text-secondary);
  }

  .submit-btn {
    padding: 0.75rem 2rem;
    background: var(--gradient-1);
    color: var(--bg-primary);
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: var(--shadow-glow);
  }

  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 30px var(--glow);
  }

  .test-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }

  .test-content :global(.question-block) {
    margin-bottom: 2rem;
  }

  .test-content :global(.question-block h3) {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--primary);
  }

  .test-content :global(.question-text) {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .test-content :global(.options) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .test-content :global(.option) {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--bg-secondary);
    border: 2px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .test-content :global(.option:hover) {
    border-color: var(--primary);
    transform: translateX(5px);
  }

  .test-content :global(.option input) {
    cursor: pointer;
  }

  .test-content :global(.option.correct) {
    border-color: #4caf50;
    background: rgba(76, 175, 80, 0.1);
  }

  .test-content :global(.option.incorrect) {
    border-color: #f44336;
    background: rgba(244, 67, 54, 0.1);
  }

  .test-content :global(.question-nav) {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .test-content :global(.nav-btn) {
    padding: 0.75rem 1.5rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .test-content :global(.nav-btn:hover) {
    border-color: var(--primary);
    color: var(--primary);
  }

  .results-section {
    max-width: 700px;
    margin: 2rem auto;
    padding: 3rem;
    text-align: center;
  }

  .results-section h2 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
  }

  .score-display {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .score-circle {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--gradient-1);
    box-shadow: 0 0 40px var(--glow);
    animation: scaleIn 0.5s ease-out;
  }

  @keyframes scaleIn {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }

  .score-circle span {
    font-size: 3rem;
    font-weight: 700;
    color: var(--bg-primary);
  }

  .score-details {
    color: var(--text-secondary);
  }

  .score-details p:first-child {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .results-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button {
    padding: 1rem 2rem;
    background: var(--gradient-1);
    color: var(--bg-primary);
    border: none;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: var(--shadow-glow);
    display: inline-block;
  }

  .button:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 30px var(--glow);
  }

  .button.secondary {
    background: transparent;
    border: 2px solid var(--primary);
    color: var(--primary);
  }

  .button.secondary:hover {
    background: var(--primary);
    color: var(--bg-primary);
  }

  @media (max-width: 768px) {
    .test-title {
      font-size: 2rem;
    }

    .test-controls {
      flex-direction: column;
      align-items: stretch;
    }

    .test-content {
      padding: 1.5rem;
    }

    .score-circle {
      width: 150px;
      height: 150px;
    }

    .score-circle span {
      font-size: 2rem;
    }
  }
</style>
