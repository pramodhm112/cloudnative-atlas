---
import Layout from '../../layouts/Layout.astro';
import Search from '../../components/Search.astro';
import ListingHeader from '../../components/ListingHeader.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import '../../styles/listing-page.css';
import { getCollection } from 'astro:content';
import { formatTag } from '../../utils/formatTag';
import { isPublished } from '../../lib/publish-status';
import { computeCategoryCounts } from '../../utils/categoryCounts';

// Client-side category filter handles the category buttons via `?category=`,
// so the page just needs the full published list up-front.
const tests = (await getCollection('tests')).filter((t) => isPublished(t.data));

const categories = ['All', 'DevOps', 'Cloud', 'AI', 'Security'];
const categoryCounts = computeCategoryCounts(tests, (t) => t.data.category);
---

<Layout
  title="Practice Tests - CloudNative Atlas"
  description="Test your knowledge with our comprehensive practice exams"
>
  <ListingHeader
    title="Practice Tests"
    subtitle="Challenge yourself with comprehensive multiple-choice exams and track your progress"
  >
    <Search
      placeholder="Search practice tests..."
      endpoint="/api/tests.json"
      urlPrefix="/practice-tests"
      variant="difficulty"
      notFoundText="No tests found"
    />
    <CategoryFilter categories={categories} itemLabel="tests" counts={categoryCounts} total={tests.length} />
  </ListingHeader>

  <section class="listing-content">
    <div class="container">
      {tests.length === 0 ? (
        <div class="no-results-state">
          <p>No tests available in this category. Check back soon!</p>
        </div>
      ) : (
        <div class="listing-grid">
          {tests.map((test) => (
            <article class="test-card listing-card glass" data-category={test.data.category}>
              <div class="card-badges">
                <span class={`category-badge ${test.data.category.toLowerCase()}`}>
                  {test.data.category}
                </span>
                <span class={`difficulty-badge ${test.data.difficulty.toLowerCase()}`}>
                  {test.data.difficulty}
                </span>
              </div>

              <h2 class="card-title">{test.data.title}</h2>
              <p class="card-desc">{test.data.description}</p>

              {test.data.tags && test.data.tags.length > 0 && (
                <div class="card-tags">
                  {test.data.tags.map((tag) => (
                    <span class="tag">{formatTag(tag)}</span>
                  ))}
                </div>
              )}

              <div class="test-meta">
                {test.data.timeLimit && (
                  <div class="meta-item">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>{test.data.timeLimit} min</span>
                  </div>
                )}
                <div class="meta-item">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                  </svg>
                  <span>Passing: {test.data.passingScore}%</span>
                </div>
              </div>

              <a href={`/practice-tests/${test.id}`} class="start-test-btn">
                Start Test
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  /* Practice-tests-specific (shared card styles in listing-page.css) */

  .test-meta {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .meta-item svg {
    color: var(--primary);
  }

  .start-test-btn {
    display: block;
    text-align: center;
    padding: 1rem;
    background: var(--gradient-1);
    color: var(--bg-primary);
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: var(--shadow-glow);
  }

  .start-test-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 30px var(--glow);
  }
</style>

<script>
  import { initCategoryFilter } from '../../scripts/category-filter';
  initCategoryFilter('.test-card', false);
</script>
