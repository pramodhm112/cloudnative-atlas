---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 - Page Not Found | CloudNative Atlas"
  description="The page you're looking for doesn't exist. Navigate back to CloudNative Atlas to explore our DevOps, Cloud, AI, and Security content."
>
  <div class="error-container">
    <div class="error-content glass">
      <div class="error-code">404</div>
      <h1 class="error-title">Page Not Found</h1>
      <p class="error-message">
        Looks like you've ventured into uncharted territory. The page you're looking for doesn't exist in our CloudNative ecosystem.
      </p>

      <div class="error-actions">
        <a href="/" class="btn-primary">
          <span class="icon">🏠</span>
          Back to Home
        </a>
        <a href="/blog" class="btn-secondary">
          <span class="icon">📚</span>
          Explore Blog
        </a>
        <a href="/practice-tests" class="btn-secondary">
          <span class="icon">📝</span>
          Practice Tests
        </a>
      </div>

      <div class="suggestions">
        <h3>Popular Pages:</h3>
        <ul>
          <li><a href="/blog">Blog Articles</a></li>
          <li><a href="/practice-tests">Practice Tests</a></li>
          <li><a href="/">CloudNative Atlas Home</a></li>
        </ul>
      </div>
    </div>

    <div class="floating-particles">
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
    </div>
  </div>
</Layout>

<style>
  .error-container {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    position: relative;
    overflow: hidden;
  }

  .error-content {
    max-width: 800px;
    width: 100%;
    padding: 4rem 3rem;
    text-align: center;
    position: relative;
    z-index: 2;
    animation: fadeInScale 0.6s ease-out;
  }

  .error-code {
    font-size: 10rem;
    font-weight: 700;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1;
    margin-bottom: 1rem;
    animation: glowPulse 3s ease-in-out infinite;
    text-shadow: 0 0 40px rgba(0, 229, 255, 0.5);
  }

  .error-title {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .error-message {
    font-size: 1.2rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
    line-height: 1.8;
  }

  .error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
    text-decoration: none;
    font-size: 1rem;
  }

  .btn-primary {
    background: var(--gradient-1);
    color: var(--bg-primary);
    border: 2px solid transparent;
    box-shadow: 0 0 30px rgba(0, 229, 255, 0.4);
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 40px rgba(0, 229, 255, 0.6),
                0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .btn-secondary {
    background: transparent;
    color: var(--primary);
    border: 2px solid var(--primary);
  }

  .btn-secondary:hover {
    background: rgba(0, 229, 255, 0.1);
    transform: translateY(-3px);
    box-shadow: 0 0 20px rgba(0, 229, 255, 0.3);
  }

  .icon {
    font-size: 1.3rem;
  }

  .suggestions {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .suggestions h3 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .suggestions ul {
    list-style: none;
    display: flex;
    gap: 2rem;
    justify-content: center;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
  }

  .suggestions li {
    margin: 0;
  }

  .suggestions a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
  }

  .suggestions a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gradient-1);
    transition: width 0.3s ease;
  }

  .suggestions a:hover::after {
    width: 100%;
  }

  .suggestions a:hover {
    color: var(--secondary);
  }

  /* Floating particles animation */
  .floating-particles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .particle {
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--primary);
    border-radius: 50%;
    opacity: 0.3;
    animation: float 8s infinite ease-in-out;
    box-shadow: 0 0 10px var(--primary);
  }

  .particle:nth-child(1) {
    top: 20%;
    left: 10%;
    animation-delay: 0s;
    animation-duration: 6s;
  }

  .particle:nth-child(2) {
    top: 40%;
    left: 80%;
    animation-delay: 1s;
    animation-duration: 8s;
  }

  .particle:nth-child(3) {
    top: 60%;
    left: 20%;
    animation-delay: 2s;
    animation-duration: 7s;
    background: var(--secondary);
    box-shadow: 0 0 10px var(--secondary);
  }

  .particle:nth-child(4) {
    top: 80%;
    left: 70%;
    animation-delay: 3s;
    animation-duration: 9s;
  }

  .particle:nth-child(5) {
    top: 30%;
    left: 50%;
    animation-delay: 1.5s;
    animation-duration: 7.5s;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  /* Animations */
  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes glowPulse {
    0%, 100% {
      filter: drop-shadow(0 0 20px rgba(0, 229, 255, 0.4));
    }
    50% {
      filter: drop-shadow(0 0 40px rgba(0, 229, 255, 0.8));
    }
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0) translateX(0);
    }
    25% {
      transform: translateY(-30px) translateX(20px);
    }
    50% {
      transform: translateY(-60px) translateX(-20px);
    }
    75% {
      transform: translateY(-30px) translateX(10px);
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .error-content {
      padding: 3rem 1.5rem;
    }

    .error-code {
      font-size: 6rem;
    }

    .error-title {
      font-size: 1.8rem;
    }

    .error-message {
      font-size: 1rem;
    }

    .error-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      justify-content: center;
    }

    .suggestions ul {
      flex-direction: column;
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .error-code {
      font-size: 4rem;
    }

    .error-title {
      font-size: 1.5rem;
    }
  }
</style>
